# ─────────────────────────────────────────────────────────────
# Londway Capital — User App Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env.local (never commit .env.local to git)
# For production, add these as GitHub Repository Secrets:
#   Settings → Secrets and variables → Actions → New repository secret
# ─────────────────────────────────────────────────────────────

# ── EmailJS (for OTP and notification emails) ──────────────────
# 1. Sign up at https://www.emailjs.com (free tier: 200 emails/month)
# 2. Create an Email Service (Gmail, Outlook, SMTP, etc.)
# 3. Create two Email Templates — one for OTP, one for Notifications
#    Both templates must include a variable named: {{html_content}}
#    Other available variables: {{to_email}}, {{to_name}}, {{subject}}, {{from_name}}
# 4. Copy your credentials below

NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx
NEXT_PUBLIC_EMAILJS_TEMPLATE_OTP=template_xxxxxxx
NEXT_PUBLIC_EMAILJS_TEMPLATE_WELCOME=template_xxxxxxx
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxx

# ── API (optional — only needed if you add a backend) ──────────
NEXT_PUBLIC_API_URL=https://api.londwaycapital.com

# ── Supabase (REQUIRED for cross-device login) ────────────────
# Without these, users can ONLY log in on the same browser where
# the admin created them. With Supabase, users log in from any device.
#
# Setup (5 minutes, free):
#   1. Sign up at https://supabase.com (free tier: 500 MB, 50K users)
#   2. Create a new project (any name, e.g. "londway")
#   3. Go to SQL Editor and run this query:
#
#      CREATE TABLE accounts (
#        email TEXT PRIMARY KEY,
#        password TEXT NOT NULL,
#        pin TEXT DEFAULT '',
#        name TEXT NOT NULL,
#        role TEXT DEFAULT 'user',
#        tier TEXT DEFAULT 'Standard',
#        balance NUMERIC DEFAULT 0,
#        phone TEXT DEFAULT '',
#        bank_accounts JSONB DEFAULT '[]',
#        created_at TIMESTAMPTZ DEFAULT now()
#      );
#      ALTER TABLE accounts ENABLE ROW LEVEL SECURITY;
#      CREATE POLICY "allow_all" ON accounts FOR ALL USING (true) WITH CHECK (true);
#
#   4. Go to Settings → API → Copy "Project URL" and "anon public" key:

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx
